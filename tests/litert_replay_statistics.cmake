# Isolate lavaresults.json from other replay tests sharing the build directory.
set(results_dir "${TRACE}.results")
file(MAKE_DIRECTORY "${results_dir}")
file(REMOVE "${results_dir}/lavaresults.json")
if(DEFINED ENV{LITERT_MODEL_PATH} AND NOT "$ENV{LITERT_MODEL_PATH}" STREQUAL "")
	get_filename_component(model_path "$ENV{LITERT_MODEL_PATH}" ABSOLUTE)
	set(ENV{LITERT_MODEL_PATH} "${model_path}")
endif()
execute_process(
	COMMAND "${REPLAY}" --litert-verify-output "${TRACE}"
	WORKING_DIRECTORY "${results_dir}"
	RESULT_VARIABLE result
	OUTPUT_VARIABLE stdout
	ERROR_VARIABLE stderr
)
set(output "${stdout}${stderr}")
message("${output}")
if(NOT "${result}" STREQUAL "0")
	message(FATAL_ERROR "LiteRT-LM replay failed: ${result}")
endif()
foreach(label "Prefill speed" "Decode speed" "Init time" "Time to first token")
	if(NOT output MATCHES "${label}: +[0-9]+[.][0-9]+ (tokens/s|s)")
		message(FATAL_ERROR "Missing LiteRT-LM replay metric: ${label}")
	endif()
endforeach()
file(READ "${results_dir}/lavaresults.json" results)
string(JSON session_count LENGTH "${results}" litert_lm sessions)
if(session_count LESS 1)
	message(FATAL_ERROR "No LiteRT-LM sessions in lavaresults.json")
endif()
foreach(field session_index init_time_seconds time_to_first_token_seconds)
	string(JSON type TYPE "${results}" litert_lm sessions 0 "${field}")
	if(NOT type STREQUAL "NUMBER")
		message(FATAL_ERROR "Invalid LiteRT-LM JSON metric: ${field}")
	endif()
endforeach()
foreach(stage prefill decode)
	string(JSON turn_count LENGTH "${results}" litert_lm sessions 0 "${stage}")
	if(turn_count LESS 1)
		message(FATAL_ERROR "No ${stage} turns in lavaresults.json")
	endif()
	foreach(field tokens tokens_per_second)
		string(JSON value GET "${results}" litert_lm sessions 0 "${stage}" 0 "${field}")
		if(NOT value GREATER 0)
			message(FATAL_ERROR "Invalid LiteRT-LM ${stage} ${field}: ${value}")
		endif()
	endforeach()
endforeach()

string(JSON verification GET "${results}" litert_lm verification status)
string(JSON checked GET "${results}" litert_lm verification responses_checked)
if(NOT verification STREQUAL "passed" OR NOT checked GREATER 0)
	message(FATAL_ERROR "LiteRT-LM output verification failed or checked no responses")
endif()

string(JSON output_count LENGTH "${results}" litert_lm outputs)
if(NOT output_count EQUAL checked)
	message(FATAL_ERROR "LiteRT-LM results did not save every response")
endif()
foreach(field thread packet session_index responses_index candidate_index)
	string(JSON type TYPE "${results}" litert_lm outputs 0 "${field}")
	if(NOT type STREQUAL "NUMBER")
		message(FATAL_ERROR "Missing LiteRT-LM output identifier: ${field}")
	endif()
endforeach()
foreach(source captured replayed)
	string(JSON text GET "${results}" litert_lm outputs 0 "${source}" text)
	string(JSON status GET "${results}" litert_lm outputs 0 "${source}" status)
	if(text STREQUAL "" OR NOT status EQUAL 0)
		message(FATAL_ERROR "Missing successful ${source} LiteRT-LM output")
	endif()
endforeach()
