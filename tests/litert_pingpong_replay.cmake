set(command "${REPLAY}" --skip-missing-input)
if(DEFINED BACKEND)
	list(APPEND command --litert-backend "${BACKEND}")
endif()
set(results_dir "${TRACE}.results")
if(DEFINED BACKEND)
	set(results_dir "${TRACE}.${BACKEND}.results")
endif()
file(MAKE_DIRECTORY "${results_dir}")
file(REMOVE "${results_dir}/lavaresults.json")
if(DEFINED ENV{LITERT_MODEL_PATH} AND NOT "$ENV{LITERT_MODEL_PATH}" STREQUAL "")
	get_filename_component(model_path "$ENV{LITERT_MODEL_PATH}" ABSOLUTE)
	set(ENV{LITERT_MODEL_PATH} "${model_path}")
endif()
execute_process(COMMAND ${command} "${TRACE}" RESULT_VARIABLE result
	WORKING_DIRECTORY "${results_dir}")
if(NOT "${result}" STREQUAL "0")
	message(FATAL_ERROR "Ping-pong replay failed: ${result}")
endif()
file(READ "${results_dir}/lavaresults.json" results)
string(JSON output_count LENGTH "${results}" litert_lm outputs)
set(palette_count 0)
set(movement_count 0)
if(output_count LESS 2)
	message(FATAL_ERROR "Replay must produce palette and movement responses")
endif()
math(EXPR last_output "${output_count} - 1")
foreach(index RANGE 0 ${last_output})
	string(JSON call GET "${results}" litert_lm outputs ${index} call)
	if(call STREQUAL "litert_lm_responses_get_response_text_at")
		math(EXPR palette_count "${palette_count} + 1")
	elseif(call STREQUAL "litert_lm_json_response_get_string")
		math(EXPR movement_count "${movement_count} + 1")
		string(JSON conversation_type TYPE "${results}" litert_lm outputs ${index} conversation_index)
		if(NOT conversation_type STREQUAL "NUMBER")
			message(FATAL_ERROR "Movement response is missing its conversation index")
		endif()
		foreach(source captured replayed)
			string(JSON status GET "${results}" litert_lm outputs ${index} ${source} status)
			if(NOT status EQUAL 0)
				message(FATAL_ERROR "${source} movement getter failed: ${status}")
			endif()
			string(JSON response GET "${results}" litert_lm outputs ${index} ${source} text)
			string(JSON target GET "${response}" content 0 text)
			string(STRIP "${target}" target)
			if(NOT target MATCHES "^-?(0|[1-9][0-9]*)$" OR target LESS -100 OR target GREATER 100)
				message(FATAL_ERROR "Invalid ${source} movement target: ${target}")
			endif()
		endforeach()
	endif()
endforeach()
if(palette_count LESS 1 OR movement_count LESS 1)
	message(FATAL_ERROR "Replay must exercise both palette text and constrained integer movement")
endif()
string(JSON conversation_count LENGTH "${results}" litert_lm conversations)
if(conversation_count LESS 1)
	message(FATAL_ERROR "Missing conversation performance statistics")
endif()
message(STATUS "Checked ${palette_count} palette and ${movement_count} movement responses")
